{
  "expo": {
    "name": "UNIFY Student Wallet",
    "slug": "unify-student-wallet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "unifywallet",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.advanceuct.unifystudentwallet",
      "supportsTablet": true
    },
    "android": {
      "package": "com.advanceuct.unifystudentwallet",
      "adaptiveIcon": {
        "backgroundColor": "#0E3B31",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/android-icon-foreground.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#0E3B31",
          "dark": {
            "image": "./assets/images/android-icon-foreground.png",
            "backgroundColor": "#0E3B31"
          }
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {}
  }
}
